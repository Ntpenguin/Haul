# ──────────────────────────────────────────────────────────────────────────
# OpenVoice Agent — environment configuration
# Copy to `.env` and fill in. Only the providers you actually use are required.
# ──────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
# Public base URL Twilio can reach (e.g. an ngrok/cloudflared tunnel or your domain).
# Used to build the <Stream> websocket URL in TwiML. No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# Optional bearer token to protect the dashboard + REST API. Leave blank to disable auth.
ADMIN_TOKEN=

# Database (SQLite file path)
DB_PATH=./data/voice-agent.db

# ── Provider selection (defaults are sensible) ──
STT_PROVIDER=deepgram          # deepgram
LLM_PROVIDER=openai            # openai | anthropic
TTS_PROVIDER=elevenlabs        # elevenlabs | deepgram

# ── Speech-to-text ──
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2-phonecall

# ── LLM ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Text-to-speech ──
# ElevenLabs (recommended for quality). Outputs ulaw_8000 directly — no resampling.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Deepgram Aura (cheaper, also outputs mulaw 8000)
DEEPGRAM_TTS_MODEL=aura-asteria-en

# ── Telephony (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that places outbound calls / receives inbound (E.164, e.g. +15125551234)
TWILIO_FROM_NUMBER=
