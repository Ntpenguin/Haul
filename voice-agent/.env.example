# ──────────────────────────────────────────────────────────────────────────
# OpenVoice Agent — environment configuration
# Copy to `.env` and fill in. Only the providers/features you use are required.
# ──────────────────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development
PORT=3000
# Public HTTPS URL Twilio + Stripe + Google can reach (tunnel or your domain). No trailing slash.
PUBLIC_BASE_URL=https://your-domain.com
LOG_LEVEL=info

# ── Database (Postgres) ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openvoice

# ── Auth / security ──
# Platform admin bearer token (manages tenants, sees everything). REQUIRED in production.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Secret for signing tenant login JWTs. REQUIRED in production.
JWT_SECRET=change-me-to-another-long-random-string
CORS_ORIGIN=*

# ── Provider selection ──
# Use `mock` for a zero-API-key demo/dev mode: a rule-based receptionist that still
# greets, checks availability, books, captures leads, transfers, and hangs up — so the
# dashboard simulator and even a real Twilio call work with no provider keys.
STT_PROVIDER=deepgram          # deepgram | mock
LLM_PROVIDER=openai            # openai | anthropic | mock
TTS_PROVIDER=elevenlabs        # elevenlabs | deepgram | mock

# ── Speech-to-text (Deepgram) ──
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2-phonecall

# ── LLM ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Text-to-speech ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
DEEPGRAM_TTS_MODEL=aura-asteria-en

# ── Telephony (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Verify X-Twilio-Signature on webhooks (recommended true in prod).
TWILIO_VALIDATE_SIGNATURE=true

# ── Billing (Stripe) — enables self-serve subscriptions + metered minutes ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring base plan price id (flat monthly w/ included minutes).
STRIPE_PRICE_SUBSCRIPTION=
# Optional metered per-minute overage price id (usage-based).
STRIPE_PRICE_METERED=

# ── Calendar (Google) — optional; falls back to built-in calendar ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) — optional; post-call summaries + notifications ──
RESEND_API_KEY=
EMAIL_FROM=OpenVoice Agent <noreply@yourdomain.com>

# ── Observability (optional) ──
SENTRY_DSN=
